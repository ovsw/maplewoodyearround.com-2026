NEXT_PUBLIC_SITE_NAME=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_STUDIO_URL=
NEXT_PUBLIC_SITE_ENV=
NEXT_PUBLIC_SANITY_API_VERSION=
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
OG_IMAGE_SECRET=
SANITY_API_READ_TOKEN=
# Lets the Sanity Function that refreshes content on publish call the
# Website. Only the deployed Website needs it; see docs/deployment.md.
SANITY_REVALIDATE_SECRET=
# Website Google Maps key (map only) and Map ID for the bus map.
# Values: MDC_GOOGLE_MAPS_WEBSITE_KEY and MDC_GOOGLE_MAPS_MAP_ID in ~/.config/ovs/secrets.env.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
# Newsletter bot check (Cloudflare Turnstile). Locally, use Cloudflare's test
# keys, which always pass: site key 1x00000000000000000000AA, secret key
# 1x0000000000000000000000000000000AA. See docs/deployment.md.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
